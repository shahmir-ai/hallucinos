{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["server", "kernel", "test", "e2e", "scripts"]
}
