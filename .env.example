
GROQ_API_KEY=
# Optional
GOOGLE_API_KEY=
# NOTE (2026-09-17): there is no Groq developer plan on this account, so
# GROQ_API_KEY is empty and the two groq-* engines hide themselves. Groq is
# reached through OpenRouter instead: or-oss20-groq / or-oss120-groq pin the
# provider, or-oss20-fast asks for whatever is fastest. OPENROUTER_API_KEY is
# what turns those three on.
# Reference engines + moderation (OpenAI omni-moderation is free; without this
# key moderation silently falls back to the small local list)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Images (SPEC §12.5). fal-ai/flux-1/schnell, $0.003 per image at <= 1 MP.
# WITHOUT this key POST /api/img returns 404 and the kernel keeps its SVG
# fallback — the OS still boots, it is just drawn rather than rendered.
FAL_KEY=
# Which fal text-to-image endpoint draws them. Blank = fal-ai/flux-1/schnell,
# and an UNRECOGNISED value falls back to that rather than failing, so a typo
# here cannot take the pictures away from every visitor. Measured head to head
# on one prompt and one size, 48 images, reviews/IMG-LATENCY-2.md:
#   fal-ai/flux-1/schnell  $0.003  median 2,595 ms  p100 3,249  144 KB  <- default
#   fal-ai/sana/sprint     $0.0025 median 2,447 ms  p100 3,571  269 KB
#   fal-ai/sana            $0.001  median 2,900 ms  p100 3,349  259 KB  <- 3x cheaper
#   fal-ai/z-image/turbo   $0.005  median 6,272 ms  p100 7,676  253 KB  <- rejected
# The top three are inside each other's noise at n=6, so the default did NOT
# move on a 6% median: nobody has looked at a sana picture yet. Each endpoint is
# billed at its own rate against MAX_USD_PER_DAY and named in telemetry as
# `img_model`, and each gets its own documented step count.
IMG_MODEL=

# Server
PORT=8790
# Which engine a visitor gets when they do not pass ?engine=. SET THIS.
#
# T1/D6 (v0.5) FIXED THIS VARIABLE. Until v0.5 a value naming a real engine was
# ignored on `/` — only a mock was honoured — so the deploy recipe everyone had
# written down (`DEFAULT_ENGINE=cerebras-oss120`) left `/` on the routed, hedged
# path at the hedged price, and HANDOFF-6 §2 reproduced that three times. Now a
# value naming an engine this process holds a key for IS what `/` boots:
# /api/engines answers `{"default":"<it>","pinned":"<it>"}` and the kernel page
# carries `<body data-engine="<it>">`.
# Blank (or `auto`) means the routed, hedged lane (below). A typo falls through
# to `auto` rather than taking the product off the air.
DEFAULT_ENGINE=

# Routing and hedging (H1/H2, v0.3). `engine:"auto"` is a POLICY, not an
# engine: engines.json's `routes.default` gives each kind a primary and a hedge
# (today cerebras-oss120 primary, or-oss120-groq hedge), the two lanes race, and
# the first to produce content is the only one the visitor ever sees. An explicit
# engine id bypasses routing AND hedging, so a single engine stays judgeable.
# THE HEDGE NEEDS OPENROUTER_API_KEY. Without it the route silently demotes to
# the primary alone and `auto` is just cerebras-oss120 — no error, no hedge.
# How long a routed app/page waits for a CONTENT token from the primary before
# the second lane is started. The loser is aborted at the winner's commit point
# and bills input only, so this number IS the hedge's cost: at 0 every routed
# generation pays for a second full input pass.
# 900. HEDGE-3 measured the app/page arm alternated against unhedged: `auto` on
# a page is $0.00335 against $0.00279 (+20%) and its median first document was
# 929 ms against 801 ms — it bought no speed on a normal hour. It did win one
# page outright (Groq, 4,349 characters, with Cerebras at 0 output tokens).
HEDGE_AFTER_MS=900
# The same for boot and desktop, where SPEC §12.1 says the first second is the
# product. 0 starts both lanes at once. SET 1200 IF `auto` IS EVER PRODUCTION:
# HEDGE-2 measured 30 real boots after fixing the trigger (it was inoperative
# until then) — at 0 every boot buys a second input pass ($0.0028/boot), at
# 1,200 none did on a normal hour ($0.0019) and the slow tail is still covered.
# T1 (v0.5): 0 IS NOW DELIBERATE, AND IT IS THE BOOT ONLY. The architect's
# ruling: the boot stream is the first pixel of the product and the smallest
# prompt in it, so racing both lanes always costs ~$0.001 and buys the faster of
# two providers on a night when one of them is slow. Measured at 23:5x PKT on
# 2026-09-17 over 20 alternated real boots — see reviews/SERVER-v05.md and
# reviews/hedge-6-triggers.json.
# (The earlier argument for 1200 — HEDGE-2, HEDGE-3 — was measured when `boot`
# and `desktop` SHARED this variable, so what it priced was mostly the second
# DESKTOP. That is now HEDGE_AFTER_MS_DESKTOP, below.)
HEDGE_AFTER_MS_BOOT=0
# T1 — the desktop's own trigger, and the fix for D6. Sharing the boot's 0 meant
# every routed boot bought TWO desktops: the biggest prompt and the biggest
# document in the product, for a lane that loses 19 times in 20. 600 ms is past
# a good hour's first content token and well short of a bad hour (2.1-4.7 s of
# provider TTFB, measured on the same day as 0.55-0.7 s).
HEDGE_AFTER_MS_DESKTOP=600
# `off` (or 0/false/no) disables routing altogether: `auto` then behaves exactly
# like DEFAULT_ENGINE and nothing is ever hedged. The one-variable kill switch.
ROUTING=
# A whole routing table as JSON for one process, overriding engines.json. Ops
# lever and how the tests point a route at two fake upstreams. Leave empty.
ROUTES_JSON=

# Caps (SPEC §2.1). The count caps bound abuse; MAX_USD_PER_DAY is the budget
# (SPEC §1.8) — it is checked against each generation's worst case before any
# token is bought, and 10,000 generations/day costs far more than $25 on every
# engine, so this is the one that actually stops things.
GEN_PER_IP_PER_HOUR=60
MAX_GEN_PER_DAY=10000
MAX_USD_PER_DAY=25
# Mirror the day counters here so a redeploy does not reset them. On Railway,
# point it at a mounted volume (see DEPLOY.md). Empty = memory only.
CAPS_STATE_FILE=
# X-Forwarded-For is a client-controlled string, so it is IGNORED unless a proxy
# of ours terminated the connection. Set TRUST_PROXY=1 on Railway and NOWHERE
# else: anywhere this process is reachable directly, a client that can rotate
# the header mints itself unlimited per-IP buckets.
TRUST_PROXY=
# How many proxies of ours sit in front of the process. 0 is right for Railway's
# single edge; the client address is then the rightmost X-Forwarded-For hop.
TRUSTED_PROXY_HOPS=0
# Upstream generations allowed in flight at once. The second half of the USD
# ceiling: each admitted generation HOLDS its worst case until it settles, so
# this bounds how much can be held at once.
MAX_CONCURRENT_GEN=12
# Image calls allowed in flight at once — a lane of its OWN, not shared with
# MAX_CONCURRENT_GEN: six visitors' wallpapers used to be able to hold every
# text slot for IMG_TIMEOUT_MS and serve everyone else the over-capacity screen.
MAX_CONCURRENT_IMG=6
# A wall clock on one generation (SPEC §12.1 / I1). BAKEOFF-1 saw a page hang
# for 180 s; on timeout the stream ends with an <!--os-error--> sentinel and the
# kernel regenerates that one document once. Floored at 1000.
GEN_TIMEOUT_MS=25000
# The same, for one fal image call. Blank = 20000 (the code default, raised from
# 18000 by T3). Measured across 48 images on four endpoints (IMG-LATENCY-2): the
# sync path medians 2.4-2.9 s with a p100 of 3.2-3.6 s, so 20 s is generous by
# design — nothing on screen waits for a picture, and past this a call is only
# holding one of the MAX_CONCURRENT_IMG slots. A tight ceiling buys an empty grey
# square instead; BAKEOFF-3 killed fifteen of sixteen app pictures on a 10 s one,
# and HANDOFF-6 measured an icon sheet at 13.0 s on a quiet boot and 14.2 s under
# load — both inside 20 s, neither inside 10 s.
IMG_TIMEOUT_MS=20000
# SPEC §12.4's ring of the last 200 OS names ("never use these"). Put it on the
# same volume as CAPS_STATE_FILE. Empty = memory only.
NAMES_RING_FILE=
# Long random strings: rate-limit and moderation hashes are salted with them.
IP_SALT=
MOD_SALT=
# auto | local | off  (never off in production). auto = the local list
# synchronously plus omni-moderation BESIDE the generation (SPEC §12.1): a late
# flag aborts the stream with an <!--os-reroute--> sentinel.
MODERATION=auto
# Test-only overrides. Leave both empty in production: MODERATION_ENDPOINT
# points the remote moderation call somewhere else, and FAL_ENDPOINT points the
# image call somewhere else, overriding IMG_MODEL's URL entirely (under
# NODE_ENV=test a real fal call is refused outright, so no suite can ever buy
# an image).
MODERATION_ENDPOINT=
FAL_ENDPOINT=

# Password gate for the hosted copy (server/auth.ts). Leave unset locally.
APP_PASSWORD=
AUTH_SECRET=
